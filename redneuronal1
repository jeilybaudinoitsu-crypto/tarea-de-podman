import numpy as np
import tensorflow as tf

# 1. Preparamos los datos (TensorFlow necesita que usemos "arrays" de NumPy)
# Entradas: [Clima, Tiempo]
entradas = np.array([[0, 0], [0, 1], [1, 0], [1, 1]], dtype=float)
# Salidas deseadas: [¿Salir a correr?]
salidas = np.array([[0], [1], [0], [0]], dtype=float)

# 2. Diseñamos la red neuronal (¡Aquí está la magia!)
# Creamos un modelo secuencial (capa por capa)
modelo = tf.keras.Sequential([
    # Capa oculta: 3 neuronas, que reciben 2 entradas
    tf.keras.layers.Dense(units=3, input_shape=[2], activation='relu'),
    # Capa de salida: 1 neurona que da la respuesta final
    tf.keras.layers.Dense(units=1, activation='sigmoid')
])

# 3. Configuramos cómo va a aprender
modelo.compile(
    optimizer=tf.keras.optimizers.Adam(0.1), # El optimizador ajusta los pesos
    loss='mean_squared_error'                # La fórmula para medir el error
)

# 4. ¡A entrenar! (Le pasamos los datos y le decimos cuántas épocas correr)
print("Comenzando entrenamiento con TensorFlow...")
modelo.fit(entradas, salidas, epochs=200, verbose=0) # verbose=0 para que no llene la pantalla de texto
print("¡Modelo entrenado exitosamente!")

# 5. Ponemos a prueba la red
print("\n--- PRUEBAS CON TENSORFLOW ---")
prediccion1 = modelo.predict(np.array([[0, 1]])) # Buen clima (0) y Tiempo (1)
print(f"Buen clima y con tiempo (Debería ser cercano a 1): {prediccion1[0][0]:.4f}")

prediccion2 = modelo.predict(np.array([[1, 1]])) # Lloviendo (1) y Tiempo (1)
print(f"Lloviendo y con tiempo (Debería ser cercano a 0): {prediccion2[0][0]:.4f}")
